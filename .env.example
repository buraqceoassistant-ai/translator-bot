# Токен бота от @BotFather
BOT_TOKEN=123456:ABC...

# Google Cloud Translation API key (console.cloud.google.com → APIs → Cloud Translation → Credentials).
# Если оставить пустым — используется бесплатный deep-translator (без ключа, подходит для теста).
GOOGLE_API_KEY=

# Ключ Anthropic для точного перевода сложных сообщений (console.anthropic.com).
# Если пусто — всё переводит Google.
ANTHROPIC_API_KEY=

# Модель для "сложных" сообщений
HAIKU_MODEL=claude-haiku-5-5

# Языки по умолчанию для новых групп (zh, ru, uz, en)
DEFAULT_LANGS=zh,ru

# Сообщения длиннее N символов считаются сложными → Haiku
COMPLEX_LEN=250

# Фото в группах: 1 — переводить все фото автоматически (дороже и шумнее),
# 0 — только по /pro, по подписи "перевод"/"翻译"/"tarjima" или в личке
AUTO_PHOTO=0
